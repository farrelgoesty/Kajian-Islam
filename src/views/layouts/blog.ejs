<!DOCTYPE html>
<html lang="id" class="h-full">

<head>
  <% const pageMeta=typeof meta !=="undefined" && meta ? meta : {}; %>
    <% const siteTitle=typeof appName !=="undefined" ? appName : "Karir & Produktivitas Muslim" ; %>
      <% const navbarTitle="Karir & Produktivitas Muslim"; %>
      <% const year=typeof currentYear !=="undefined" ? currentYear : new Date().getFullYear(); %>
        <% const pageTitle=typeof title !=="undefined" ? title : "" ; %>
          <meta charset="utf-8" />
          <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
          <title>
            <%= pageMeta.title || pageTitle || siteTitle %> · Inspirasi & Hijrah Modern
          </title>
          <script>
            document.documentElement.classList.remove("dark");
            document.documentElement.style.colorScheme = "light";
          </script>
          <!-- Google Fonts Premium: Ultra Modern & Elegant -->
          <link rel="preconnect" href="https://fonts.googleapis.com" />
          <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
          <link
            href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&display=swap"
            rel="stylesheet" />
          <link rel="stylesheet" href="/css/app.css" />
          <meta name="description"
            content="<%= pageMeta.description || 'Platform karir dan produktivitas muslim modern yang inspiratif dan profesional.' %>" />
          <% if (pageMeta.robots) { %>
            <meta name="robots" content="<%= pageMeta.robots %>" />
            <% } %>
              <% if (pageMeta.canonical) { %>
                <link rel="canonical" href="<%= pageMeta.canonical %>" />
                <% } %>
                  <% if (pageMeta.image) { %>
                    <meta property="og:image" content="<%= pageMeta.image %>" />
                    <% } %>
                      <% if (pageMeta.canonical) { %>
                        <meta property="og:url" content="<%= pageMeta.canonical %>" />
                        <% } %>
                          <meta property="og:title" content="<%= pageMeta.title || pageTitle || siteTitle %>" />
                          <meta property="og:description"
                            content="<%= pageMeta.description || 'Platform karir dan produktivitas muslim modern yang inspiratif dan profesional.' %>" />
                          <meta property="og:type" content="<%= pageMeta.type || 'website' %>" />
                          <meta name="twitter:card" content="summary_large_image" />
                          <meta name="twitter:title" content="<%= pageMeta.title || pageTitle || siteTitle %>" />
                          <meta name="twitter:description"
                            content="<%= pageMeta.description || 'Platform karir dan produktivitas muslim modern yang inspiratif dan profesional.' %>" />
                          <% if (pageMeta.image) { %>
                            <meta name="twitter:image" content="<%= pageMeta.image %>" />
                            <% } %>

                              <!-- Tailwind CSS + Custom Config Premium -->
                              <script src="https://cdn.tailwindcss.com"></script>
                              <script>
                                tailwind.config = {
                                  darkMode: "class",
                                  theme: {
                                    extend: {
                                      fontFamily: {
                                        sans: ["Inter", "system-ui", "sans-serif"],
                                        serif: ["Playfair Display", "Georgia", "serif"]
                                      },
                                      boxShadow: {
                                        'elevated': '0 20px 35px -12px rgba(0,0,0,0.05), 0 1px 2px rgba(0,0,0,0.02)',
                                        'card': '0 12px 24px -12px rgba(0,0,0,0.08), 0 1px 2px rgba(0,0,0,0.02)',
                                        'card-hover': '0 25px 35px -12px rgba(0,0,0,0.12), 0 2px 4px rgba(0,0,0,0.02)',
                                        'soft-sm': '0 2px 8px rgba(0,0,0,0.02)'
                                      },
                                      colors: {
                                        brand: {
                                          50: "#ecfdf5",
                                          100: "#d1fae5",
                                          200: "#a7f3d0",
                                          300: "#6ee7b7",
                                          400: "#34d399",
                                          500: "#0f7660",
                                          600: "#0b5a49",
                                          700: "#094437",
                                          800: "#06352a",
                                          900: "#04251d"
                                        },
                                        background: "#FCF9F6",
                                        surface: "#FFFFFF",
                                        muted: "#78716C"
                                      }
                                    }
                                  }
                                };
                              </script>
                              <script
                                src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
                              <script src="/js/app.js" defer></script>
                              <style>
                                /* custom modern professional */
                                body {
                                  background: #F4F9FC;
                                  font-family: 'Inter', system-ui, -apple-system, sans-serif;
                                  letter-spacing: -0.01em;
                                  -webkit-font-smoothing: antialiased;
                                }

                                .wp-shell {
                                  background: #F4F9FC;
                                }

                                /* Navbar ultra-modern glassmorphism halus */
                                .blog-nav-shell {
                                  background: rgba(255, 255, 255, 0.92);
                                  backdrop-filter: blur(20px);
                                  border-radius: 2rem;
                                  border: 0.5px solid rgba(201, 226, 234, 0.9);
                                  box-shadow: 0 8px 22px -14px rgba(25, 70, 85, 0.2);
                                  transition: all 0.3s ease;
                                }

                                .blog-brand-card {
                                  gap: 0.75rem;
                                  padding: 0.4rem 1rem;
                                  border-radius: 2rem;
                                  transition: all 0.2s;
                                  display: flex;
                                  align-items: center;
                                }

                                .blog-brand-mark {
                                  background: linear-gradient(145deg, #176D7A, #2C7A6E);
                                  box-shadow: 0 6px 14px rgba(23, 109, 122, 0.28);
                                  transition: transform 0.2s ease;
                                }

                                .blog-brand-card:hover .blog-brand-mark {
                                  transform: translateY(-2px);
                                }

                                .blog-brand-name {
                                  font-weight: 700;
                                  font-size: 1.25rem;
                                  letter-spacing: -0.02em;
                                  background: linear-gradient(125deg, #176D7A, #2C7A6E);
                                  background-clip: text;
                                  -webkit-background-clip: text;
                                  color: transparent;
                                }

                                .blog-search-card {
                                  background: white;
                                  border-radius: 2rem;
                                  border: 1px solid #D4E9EF;
                                  transition: all 0.2s;
                                }

                                .blog-search-card:focus-within {
                                  border-color: #176D7A;
                                  box-shadow: 0 0 0 3px rgba(23, 109, 122, 0.1);
                                }

                                .blog-search-input {
                                  background: transparent;
                                  border: none;
                                  padding: 0.7rem 1rem 0.7rem 2.8rem;
                                  font-size: 0.85rem;
                                  border-radius: 2rem;
                                  font-weight: 400;
                                }

                                .blog-search-input:focus {
                                  outline: none;
                                  ring: none;
                                }

                                footer {
                                  background: #FFFFFF;
                                  border-top: 1px solid #D4E9EF;
                                }

                                /* custom scrollbar */
                                ::-webkit-scrollbar {
                                  width: 6px;
                                  height: 6px;
                                }

                                ::-webkit-scrollbar-track {
                                  background: #EAF4F8;
                                  border-radius: 10px;
                                }

                                ::-webkit-scrollbar-thumb {
                                  background: #9FCAD5;
                                  border-radius: 10px;
                                }

                                /* smooth hover on links */
                                a,
                                button {
                                  transition: all 0.2s cubic-bezier(0.2, 0, 0, 1);
                                }

                                /* slider track premium */
                                .slider-track-premium {
                                  scrollbar-width: thin;
                                  scrollbar-color: #9FCAD5 #EAF4F8;
                                }

                                .slider-track-premium::-webkit-scrollbar {
                                  height: 5px;
                                }

                                .slider-track-premium::-webkit-scrollbar-track {
                                  background: #EAF4F8;
                                  border-radius: 20px;
                                }

                                .slider-track-premium::-webkit-scrollbar-thumb {
                                  background: #9FCAD5;
                                  border-radius: 20px;
                                }
                              </style>
</head>

<body class="min-h-full wp-shell">
  <script>
    window.CMS_CSRF_TOKEN = "";
    window.CMS_INITIAL_NOTICES = <% - JSON.stringify((typeof notice !== "undefined" && notice) ? [{ type: typeof noticeType !== "undefined" && noticeType ? noticeType : "info", message: notice }] : []) %>;
  </script>

  <!-- HEADER SUPER MODERN & PROFESIONAL -->
  <header class="sticky top-0 z-50 px-3 pt-3 sm:px-4 lg:px-5">
    <div class="blog-nav-shell mx-auto w-full max-w-[96rem]">
      <div class="flex flex-col gap-2 px-4 py-2.5 lg:flex-row lg:items-center lg:gap-5 lg:px-6">
        <a href="/" class="blog-brand-card group">
          <span
            class="blog-brand-mark inline-flex h-10 w-10 items-center justify-center rounded-full bg-gradient-to-br from-[#176D7A] to-[#124F5E] text-base font-bold leading-none text-white shadow-sm transition-all duration-200 group-hover:scale-105">K</span>
          <span class="blog-brand-name font-semibold tracking-tight">
            <%= navbarTitle %>
          </span>
        </a>

        <!-- Search bar minimalis modern -->
        <form action="/search" method="get" class="w-full lg:ml-auto lg:max-w-md">
          <div class="blog-search-card">
            <label class="relative block">
              <span class="sr-only">Cari kajian</span>
              <span class="pointer-events-none absolute inset-y-0 left-4 flex items-center text-brand-400">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"
                    d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
              </span>
              <input name="q" placeholder="Cari artikel..."
                class="blog-search-input w-full border-none bg-transparent py-2 pl-10 pr-4 text-sm text-stone-700 placeholder:text-stone-400 focus:outline-none focus:ring-0" />
            </label>
          </div>
        </form>
      </div>
    </div>
  </header>

  <main class="mx-auto max-w-7xl px-4 py-8 lg:px-8">
    <%- body %>
  </main>

  <!-- FOOTER MODERN PROFESIONAL -->
  <footer class="border-t border-[#EDE3D9] bg-white">
    <div class="mx-auto max-w-7xl px-4 py-12 lg:px-8">
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        <div class="space-y-3">
          <div class="flex items-center gap-2.5">
            <span
              class="flex h-9 w-9 items-center justify-center rounded-full bg-gradient-to-br from-[#176D7A] to-[#124F5E] text-sm font-semibold text-white shadow-sm">K</span>
            <span class="font-serif text-lg font-semibold tracking-tight text-stone-800">
              <%= navbarTitle %>
            </span>
          </div>
          <p class="max-w-md text-sm leading-relaxed text-stone-500">
            Platform karir dan produktivitas muslim modern untuk belajar, bertumbuh, dan berbagi insight dengan
            tampilan yang tenang dan profesional.
          </p>
        </div>
        <div>
          <h3 class="text-xs font-semibold uppercase tracking-wider text-stone-400">Navigasi</h3>
          <ul class="mt-4 space-y-2.5 text-sm">
            <li><a href="/" class="text-stone-600 transition hover:text-brand-600">Beranda</a></li>
            <li><a href="/search" class="text-stone-600 transition hover:text-brand-600">Cari Kajian</a></li>
            <li><a href="/admin/login" class="text-stone-600 transition hover:text-brand-600">Dashboard</a></li>
          </ul>
        </div>
        <div>
          <h3 class="text-xs font-semibold uppercase tracking-wider text-stone-400">Tentang</h3>
          <p class="mt-4 text-sm leading-relaxed text-stone-500">
            Untuk pertanyaan atau kolaborasi dakwah digital, silakan hubungi kanal resmi pengelola kajian.
          </p>
        </div>
      </div>
      <div
        class="mt-10 flex flex-col justify-between gap-3 border-t border-stone-100 pt-6 text-xs text-stone-400 sm:flex-row">
        <span>© <%= year %> · <%= siteTitle %></span>
        <span>Dibangun dengan Node.js, Express, Prisma & Tailwind</span>
      </div>
    </div>
  </footer>

  <!-- INISIALISASI SLIDER UNTUK KONTEN HORIZONTAL (jika ada di halaman) -->
  <script>
    (function initGlobalSlider() {
      const initSlider = () => {
        const track = document.querySelector('.js-slider-track');
        if (!track) return;
        const leftBtn = document.getElementById('js-slide-left');
        const rightBtn = document.getElementById('js-slide-right');
        if (leftBtn && rightBtn) {
          const step = 380;
          leftBtn.addEventListener('click', () => track.scrollBy({ left: -step, behavior: 'smooth' }));
          rightBtn.addEventListener('click', () => track.scrollBy({ left: step, behavior: 'smooth' }));
        }
        let isDown = false, startX, scrollLeft;
        track.addEventListener('mousedown', (e) => {
          isDown = true;
          startX = e.pageX - track.offsetLeft;
          scrollLeft = track.scrollLeft;
          track.style.cursor = 'grabbing';
        });
        track.addEventListener('mouseleave', () => { isDown = false; track.style.cursor = 'grab'; });
        track.addEventListener('mouseup', () => { isDown = false; track.style.cursor = 'grab'; });
        track.addEventListener('mousemove', (e) => {
          if (!isDown) return;
          e.preventDefault();
          const x = e.pageX - track.offsetLeft;
          const walk = (x - startX) * 1.2;
          track.scrollLeft = scrollLeft - walk;
        });
        track.style.cursor = 'grab';
      };
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initSlider);
      else initSlider();
    })();
  </script>
  <style>
    /* tambahan styling premium untuk konsistensi */
    .blog-search-card {
      transition: box-shadow 0.2s, border-color 0.2s;
    }

    .blog-nav-shell {
      transition: background 0.2s, backdrop-filter 0.2s;
    }

    .wp-shell a:not(.no-transition) {
      text-decoration: none;
    }

    /* membuat tampilan card lebih modern di area body nanti */
    .prose-custom {
      line-height: 1.6;
    }
  </style>
</body>

</html>
