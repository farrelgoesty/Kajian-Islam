<!DOCTYPE html>
<html lang="id">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="description"
    content="Platform karir dan produktivitas untuk Muslim modern. Kelola waktu, tingkatkan skill, raih berkah dalam setiap langkah profesional.">
  <title>Karir & Produktivitas Muslim · Berkah & Excellence</title>
  <!-- Google Fonts: Modern & Professional -->
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Cormorant+Garamond:wght@500;600;700&display=swap"
    rel="stylesheet">
  <!-- Font Awesome 6 (CDN resmi) -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      background: #F4F9FC;
      color: #0A2B38;
      line-height: 1.5;
      overflow-x: hidden;
    }

    .home-container {
      max-width: 1440px;
      margin: 0 auto;
      padding: 2rem 2rem 2.5rem;
    }

    /* ========== HERO SECTION ========== */
    .hero-luxury {
      background: linear-gradient(135deg, #EAF4F8 0%, #FFFFFF 40%, #E0F0F5 100%);
      border-radius: 2.8rem;
      padding: 3.5rem 3rem;
      margin-bottom: 3rem;
      position: relative;
      overflow: hidden;
      border: 1px solid #C9E2EA;
      box-shadow: 0 24px 44px -18px rgba(25, 70, 85, 0.12);
      text-align: center;
    }

    .hero-luxury::before {
      content: "﷽";
      font-size: 260px;
      font-family: serif;
      position: absolute;
      bottom: -50px;
      left: -20px;
      opacity: 0.04;
      color: #2C7A6E;
      pointer-events: none;
    }

    .hero-luxury::after {
      content: "★";
      font-size: 200px;
      position: absolute;
      top: -30px;
      right: 0px;
      opacity: 0.045;
      color: #D9A13B;
      transform: rotate(12deg);
      pointer-events: none;
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      background: rgba(255, 255, 250, 0.95);
      backdrop-filter: blur(8px);
      padding: 0.45rem 2rem;
      border-radius: 60px;
      font-size: 0.7rem;
      font-weight: 800;
      letter-spacing: 0.2em;
      color: #2C7A6E;
      margin-bottom: 1.2rem;
      border: 0.5px solid #C0DFE8;
    }

    .hero-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: 4rem;
      font-weight: 700;
      letter-spacing: -0.01em;
      line-height: 1.2;
      max-width: 85%;
      margin: 0 auto;
      color: #124F5E;
    }

    .hero-title span {
      background: linear-gradient(125deg, #E6B422, #C9921F);
      background-clip: text;
      -webkit-background-clip: text;
      color: transparent;
    }

    .hero-desc {
      margin-top: 1rem;
      font-size: 1.05rem;
      color: #3B6F7A;
      max-width: 68%;
      margin-left: auto;
      margin-right: auto;
    }

    /* ========== PILAR UTAMA ========== */
    .value-pillars {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
      gap: 2rem;
      margin-bottom: 3rem;
    }

    .pillar-card {
      background: rgba(255, 255, 255, 0.96);
      border-radius: 2rem;
      padding: 2rem 1.4rem;
      text-align: center;
      border: 1px solid #D4E9EF;
      transition: all 0.3s cubic-bezier(0.2, 0, 0, 1);
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.02);
    }

    .pillar-card:hover {
      transform: translateY(-8px);
      border-color: #B8D8E1;
      background: #FFFFFF;
      box-shadow: 0 18px 32px -12px rgba(30, 100, 100, 0.12);
    }

    .pillar-card i {
      font-size: 2.5rem;
      color: #D9A13B;
      margin-bottom: 1rem;
      display: inline-block;
    }

    .pillar-card h4 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.5rem;
      font-weight: 700;
      color: #176D7A;
      margin-bottom: 0.5rem;
    }

    .pillar-card p {
      font-size: 0.85rem;
      color: #58818C;
      line-height: 1.5;
    }

    /* ========== SLIDER ARTIKEL ========== */
    .slider-section {
      margin-bottom: 2.5rem;
    }

    .section-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      flex-wrap: wrap;
      margin-bottom: 1.5rem;
    }

    .section-header h2 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 2rem;
      font-weight: 700;
      color: #176D7A;
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }

    .section-header h2 i {
      color: #D9A13B;
      font-size: 1.8rem;
    }

    .slider-wrapper {
      position: relative;
      width: 100%;
      overflow-x: hidden;
      border-radius: 1.8rem;
      padding: 0 3.2rem;
    }

    .slider-track {
      display: flex;
      gap: 2rem;
      overflow-x: auto;
      scroll-behavior: smooth;
      scrollbar-width: thin;
      padding-bottom: 1rem;
      cursor: grab;
      scroll-snap-type: x mandatory;
    }

    .slider-track::-webkit-scrollbar {
      height: 6px;
    }

    .slider-track::-webkit-scrollbar-track {
      background: #D4E9EF;
      border-radius: 12px;
    }

    .slider-track::-webkit-scrollbar-thumb {
      background: #B0D1D9;
      border-radius: 12px;
    }

    .post-card-horizontal {
      flex: 0 0 350px;
      background: #FFFFFF;
      border-radius: 2rem;
      overflow: hidden;
      transition: all 0.35s ease;
      border: 1px solid #D4E9EF;
      box-shadow: 0 16px 28px -12px rgba(30, 80, 80, 0.08);
      display: flex;
      flex-direction: column;
      scroll-snap-align: start;
    }

    .post-card-horizontal:hover {
      transform: translateY(-8px);
      box-shadow: 0 28px 38px -14px rgba(30, 90, 90, 0.2);
      border-color: #BBDDE6;
    }

    .card-img {
      aspect-ratio: 16/9;
      background: #E2F0F2;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .card-img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.45s ease;
    }

    .post-card-horizontal:hover .card-img img {
      transform: scale(1.04);
    }

    .card-img i {
      font-size: 3rem;
      color: #2C7A6E;
    }

    .card-body {
      padding: 1.4rem 1.4rem 1.6rem;
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    .category-chip {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: #F0F8FA;
      padding: 0.25rem 1rem;
      border-radius: 30px;
      font-size: 0.65rem;
      font-weight: 700;
      color: #2C7A6E;
      width: fit-content;
    }

    .card-title {
      font-size: 1.25rem;
      font-weight: 700;
      line-height: 1.35;
      margin: 0.7rem 0 0.5rem;
    }

    .card-title a {
      text-decoration: none;
      color: #124F5E;
      transition: color 0.2s;
    }

    .card-title a:hover {
      color: #D9A13B;
    }

    .excerpt-sm {
      font-size: 0.8rem;
      line-height: 1.5;
      color: #6C8F99;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      margin: 0.3rem 0 0.8rem;
    }

    .meta-horizontal {
      display: flex;
      justify-content: space-between;
      font-size: 0.7rem;
      font-weight: 500;
      color: #8CACB5;
      border-top: 1px solid #E2F0F2;
      padding-top: 0.8rem;
      margin-top: auto;
    }

    .meta-horizontal i {
      margin-right: 4px;
    }

    .slider-controls-bottom {
      position: absolute;
      top: 50%;
      left: 0;
      right: 0;
      transform: translateY(-50%);
      display: flex;
      justify-content: space-between;
      align-items: center;
      pointer-events: none;
      z-index: 2;
    }

    .slider-btn-bottom {
      background: #FFFFFF;
      border: 1px solid #C9E2EA;
      width: 46px;
      height: 46px;
      border-radius: 50%;
      cursor: pointer;
      transition: all 0.2s;
      color: #2C7A6E;
      font-size: 1.1rem;
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.02);
      pointer-events: auto;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .slider-btn-bottom:hover {
      background: #F0F8FA;
      border-color: #AACFD9;
      transform: scale(1.03);
    }

    /* ========== KATEGORI & TAGS ========== */
    .categories-tags-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
      margin: 2.5rem 0 2rem;
    }

    .premium-card {
      background: #FFFFFF;
      border-radius: 2rem;
      padding: 1.8rem;
      border: 1px solid #D4E9EF;
      transition: all 0.2s;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.02);
    }

    .premium-card h3 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.5rem;
      font-weight: 700;
      color: #176D7A;
      margin-bottom: 1.2rem;
      display: flex;
      align-items: center;
      gap: 10px;
      border-bottom: 2px solid #E2F0F2;
      padding-bottom: 0.6rem;
    }

    .premium-card h3 i {
      color: #D9A13B;
    }

    .tag-group,
    .category-group {
      display: flex;
      flex-wrap: wrap;
      gap: 0.8rem;
    }

    .pill-link {
      background: #F8FDFF;
      padding: 0.5rem 1.2rem;
      border-radius: 3rem;
      font-size: 0.75rem;
      font-weight: 500;
      text-decoration: none;
      color: #2C7A6E;
      transition: all 0.2s;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      border: 0.5px solid #C9E2EA;
    }

    .pill-link:hover {
      background: #EFF7FA;
      color: #D9A13B;
      transform: translateY(-2px);
    }

    /* ========== QUOTE HARIAN ========== */
    .daily-quote {
      background: #F8FDFF;
      border-radius: 2rem;
      padding: 2rem;
      margin: 2rem 0 0;
      text-align: center;
      border: 1px solid #D4E9EF;
    }

    .daily-quote-text {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.35rem;
      font-weight: 600;
      line-height: 1.55;
      letter-spacing: 0.01em;
      color: #124F5E;
      max-width: 80%;
      margin: 0.8rem auto;
      text-wrap: balance;
    }

    .daily-quote-note {
      margin-top: 0.6rem;
      font-family: 'Plus Jakarta Sans', 'Inter', system-ui, sans-serif;
      font-size: 0.82rem;
      font-weight: 600;
      letter-spacing: 0.02em;
      color: #2C7A6E;
    }

    /* ========== PAGINATION ========== */
    .pagination-modern {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 0.7rem;
      margin-top: 2rem;
      flex-wrap: wrap;
    }

    .pagination-modern a,
    .pagination-modern span {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 2.5rem;
      height: 2.5rem;
      padding: 0 0.9rem;
      border-radius: 2.2rem;
      font-size: 0.85rem;
      font-weight: 500;
      text-decoration: none;
      background: #FFFFFF;
      color: #2C7A6E;
      border: 1px solid #D4E9EF;
    }

    .pagination-modern .active-page {
      background: #D9A13B;
      color: #FFFFFF;
      border-color: #C9921F;
    }

    /* ========== TIPS GRID ========== */
    .tips-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 1.8rem;
      margin: 2.5rem 0;
    }

    .tip-card {
      background: #FFFFFF;
      border-radius: 1.8rem;
      padding: 1.5rem;
      border: 1px solid #D4E9EF;
      transition: transform 0.2s;
    }

    .tip-card:hover {
      transform: translateY(-4px);
    }

    .tip-card i {
      font-size: 1.8rem;
      color: #D9A13B;
      margin-bottom: 0.8rem;
      display: block;
    }

    .tip-card h3 {
      margin: 0.6rem 0 0.2rem;
      font-weight: 700;
      color: #176D7A;
    }

    .tip-card p {
      font-family: 'Plus Jakarta Sans', 'Inter', system-ui, sans-serif;
      font-size: 0.9rem;
      font-weight: 500;
      letter-spacing: 0.01em;
      line-height: 1.6;
      color: #2A6270;
    }

    /* ========== BUKU & CHALLENGE ========== */
    .books-section {
      background: #EAF4F8;
      border-radius: 1.8rem;
      padding: 1.8rem;
      margin: 1rem 0 1.5rem;
    }

    .challenge-section {
      background: #FFFFFF;
      border-radius: 1.8rem;
      padding: 1.8rem;
      margin: 1.5rem 0;
      border: 1px solid #C9E2EA;
    }

    .challenge-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 12px;
      margin-top: 1rem;
    }

    .challenge-item {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      background: linear-gradient(135deg, #F5FBFF 0%, #ECF7FB 100%);
      border: 1px solid #D6EAF1;
      border-radius: 0.9rem;
      padding: 0.75rem 0.85rem;
      color: #185A69;
      font-family: 'Plus Jakarta Sans', 'Inter', system-ui, sans-serif;
      font-size: 0.9rem;
      font-weight: 600;
      letter-spacing: 0.01em;
      line-height: 1.45;
      box-shadow: 0 6px 14px -10px rgba(17, 86, 102, 0.45);
    }

    .challenge-item i {
      color: #2C7A6E;
      margin-top: 2px;
      font-size: 0.95rem;
      flex: 0 0 auto;
    }

    .books-list .pill-link {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1rem;
      font-weight: 600;
      letter-spacing: 0.01em;
      color: #185A69;
      background: linear-gradient(135deg, #F7FCFF 0%, #EEF7FB 100%);
      border: 1px solid #D6EAF1;
      box-shadow: 0 8px 16px -14px rgba(18, 79, 94, 0.45);
    }

    .books-list .pill-link:hover {
      color: #124F5E;
      background: linear-gradient(135deg, #ECF7FB 0%, #E1F1F7 100%);
      border-color: #BFDCE7;
    }

    .habits-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
      margin: 2rem 0;
    }

    .habit-card {
      text-align: center;
      background: #F8FDFF;
      border-radius: 1.5rem;
      padding: 1rem;
      transition: transform 0.2s;
    }

    .habit-card:hover {
      transform: translateY(-4px);
    }

    .habit-card i {
      font-size: 2rem;
      color: #D9A13B;
      margin-bottom: 0.5rem;
      display: block;
    }

    .habit-card h4 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.3rem;
      font-weight: 700;
      letter-spacing: 0.02em;
      margin-bottom: 0.25rem;
      color: #176D7A;
    }

    .habit-card p {
      font-family: 'Plus Jakarta Sans', 'Inter', system-ui, sans-serif;
      font-size: 0.82rem;
      font-weight: 600;
      letter-spacing: 0.01em;
      color: #58818C;
    }

    /* ========== FOOTER ========== */
    .footer-simple {
      margin-top: 3rem;
      background: #F8FDFF;
      border-radius: 2rem;
      padding: 1.8rem;
      text-align: center;
      border: 1px solid #D4E9EF;
      color: #58818C;
      font-size: 0.8rem;
    }

    /* ========== RESPONSIVE ========== */
    @media (max-width: 880px) {
      .home-container {
        padding: 1rem;
      }

      .hero-luxury {
        padding: 2rem 1.5rem;
      }

      .hero-title {
        font-size: 2.4rem;
        max-width: 100%;
      }

      .hero-desc {
        max-width: 100%;
      }

      .post-card-horizontal {
        flex: 0 0 290px;
      }

      .slider-wrapper {
        padding: 0 2rem;
      }

      .slider-btn-bottom {
        width: 38px;
        height: 38px;
      }

      .categories-tags-grid {
        grid-template-columns: 1fr;
      }

      .habits-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 480px) {
      .habits-grid {
        grid-template-columns: 1fr;
      }

      .hero-badge {
        font-size: 0.6rem;
        letter-spacing: 0.1em;
      }
    }
  </style>
</head>

<body>
  <div class="home-container">

    <!-- HERO PREMIUM -->
    <div class="hero-luxury">
      <div class="hero-badge"><i class="fas fa-chart-line"></i> KARIR & PRODUKTIVITAS MUSLIM</div>
      <h1 class="hero-title">Bangun karir <span>berkah & excellence</span> dengan prinsip islami</h1>
      <p class="hero-desc">Integrasi antara profesionalisme duniawi dan nilai-nilai spiritual. Kelola waktu, maksimalkan
        potensi, raih kesuksesan ukhrawi.</p>
    </div>

    <!-- Pilar Utama -->
    <div class="value-pillars">
      <div class="pillar-card"><i class="fas fa-chalkboard-user"></i>
        <h4>Career With Itqan</h4>
        <p>Melakukan pekerjaan dengan profesional, tepat, dan penuh ketulusan sebagai bentuk ibadah.</p>
      </div>
      <div class="pillar-card"><i class="fas fa-clock"></i>
        <h4>Time Management Sunnah</h4>
        <p>Manajemen waktu ala generasi salaf: fokus, barokah, dan meninggalkan hal yang tidak bermanfaat.</p>
      </div>
      <div class="pillar-card"><i class="fas fa-hand-holding-heart"></i>
        <h4>Financial Barakah</h4>
        <p>Prinsip halal, sederhana, bersedekah, dan menjauhi riba untuk rezeki yang melimpah.</p>
      </div>
    </div>

    <!-- SLIDER ARTIKEL -->
    <div class="slider-section">
      <div class="section-header">
        <h2><i class="fas fa-newspaper"></i> Artikel Pilihan Karir & Produktivitas</h2>
      </div>
      <div class="slider-wrapper">
        <div class="slider-controls-bottom">
          <button class="slider-btn-bottom" id="slideLeftBottom" aria-label="Previous"><i
              class="fas fa-chevron-left"></i></button>
          <button class="slider-btn-bottom" id="slideRightBottom" aria-label="Next"><i
              class="fas fa-chevron-right"></i></button>
        </div>
        <div class="slider-track" id="sliderTrack">
          <% if (typeof posts !=='undefined' && posts && posts.length) { posts.forEach((post)=> { %>
            <div class="post-card-horizontal">
              <div class="card-img">
                <% if (post.featuredImage) { %><img src="<%= post.featuredImage %>" alt="<%= post.title %>"
                    loading="lazy">
                  <% } else { %>
                    <i class="fas fa-briefcase"></i>
                    <% } %>
              </div>
              <div class="card-body">
                <span class="category-chip"><i class="fas fa-tag"></i>
                  <%= post.postCategories && post.postCategories.length ? post.postCategories[0].category.name : (post.postTags && post.postTags.length ? post.postTags[0].tag.name : 'Karir') %>
                </span>
                <h3 class="card-title"><a href="/posts/<%= post.slug %>" target="_blank" rel="noopener noreferrer">
                    <%= post.title %>
                  </a></h3>
                <p class="excerpt-sm">
                  <%= post.excerpt ? post.excerpt.slice(0,110)
                    : 'Tingkatkan produktivitas dan keberkahan karirmu dengan langkah strategis.' %>
                </p>
                <div class="meta-horizontal"><span><i class="far fa-clock"></i>
                    <%= post.readingTime || 5 %> menit
                  </span><span><i class="fas fa-eye"></i>
                    <%= post.viewCount || 0 %> views
                  </span></div>
              </div>
            </div>
            <% }) } else { %>
              <p class="excerpt-sm" style="padding: 0.75rem 0.25rem;">
                Belum ada artikel berstatus <strong>PUBLISHED</strong>. Publish artikel dari admin agar tampil di sini.
              </p>
              <% } %>
        </div>
      </div>
    </div>

    <!-- PAGINATION (dinamis) -->
    <% if (typeof pagination !=='undefined' && pagination && pagination.totalPages> 1) { %>
      <div class="pagination-modern">
        <% if (pagination.hasPrev) { %><a href="?page=<%= pagination.prevPage %>"><i class="fas fa-chevron-left"></i>
            Prev</a>
          <% } else { %><span><i class="fas fa-chevron-left"></i> Prev</span>
            <% } %>
              <% for (let p=Math.max(1, pagination.currentPage-2); p <=Math.min(pagination.totalPages,
                pagination.currentPage+2); p++) { if (p===pagination.currentPage) { %><span class="active-page">
                  <%= p %>
                </span>
                <% } else { %><a href="?page=<%= p %>">
                    <%= p %>
                  </a>
                  <% } } %>
                    <% if (pagination.hasNext) { %><a href="?page=<%= pagination.nextPage %>">Next <i
                          class="fas fa-chevron-right"></i></a>
                      <% } else { %><span>Next <i class="fas fa-chevron-right"></i></span>
                        <% } %>
      </div>
      <% } %>

        <!-- KATEGORI & TAGS -->
        <div class="categories-tags-grid">
          <div class="premium-card">
            <h3><i class="fas fa-layer-group"></i> Topik Karir Islami</h3>
            <div class="category-group">
              <% if (typeof categories !=='undefined' && categories && categories.length) { categories.forEach((cat)=> {
