<!DOCTYPE html>
<html lang="id">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Kajian Islam · Majelis Ilmu & Halaqah</title>
  <!-- Google Fonts: Elegant & Premium Typography -->
  <link
    href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Cormorant+Garamond:wght@400;500;600;700&display=swap"
    rel="stylesheet">
  <!-- Font Awesome 6 -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Plus Jakarta Sans', system-ui, -apple-system, 'Segoe UI', sans-serif;
      background: #F5FBF4;
      color: #1E2F1E;
      line-height: 1.5;
      overflow-x: hidden;
    }

    .home-container {
      max-width: 1440px;
      margin: 0 auto;
      padding: 2rem 2rem 2.5rem;
    }

    /* HERO SECTION KAJIAN ISLAM - NUANSA HIJAU */
    .hero-luxury {
      background: linear-gradient(135deg, #EAF5E6 0%, #F1FAEE 40%, #E2F0DC 100%);
      border-radius: 2.8rem;
      padding: 3.2rem 3rem 2.8rem;
      margin-bottom: 3rem;
      position: relative;
      overflow: hidden;
      border: 1px solid #CBE0C2;
      box-shadow: 0 22px 40px -14px rgba(40, 60, 35, 0.1);
      text-align: center;
    }

    .hero-luxury::before {
      content: "﷽";
      font-size: 240px;
      font-family: serif;
      position: absolute;
      bottom: -50px;
      left: -20px;
      opacity: 0.04;
      color: #5B8C4E;
      pointer-events: none;
    }

    .hero-luxury::after {
      content: "۞";
      font-size: 210px;
      position: absolute;
      top: -40px;
      right: 10px;
      opacity: 0.045;
      pointer-events: none;
      color: #6A9C5D;
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      background: rgba(255, 255, 245, 0.9);
      backdrop-filter: blur(8px);
      padding: 0.45rem 1.8rem;
      border-radius: 60px;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.2em;
      color: #3D6B2E;
      margin-bottom: 1.2rem;
      border: 0.5px solid #D0E2C5;
    }

    .hero-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: 4rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1.2;
      max-width: 85%;
      margin: 0 auto;
      color: #2A4522;
    }

    .hero-title span {
      background: linear-gradient(125deg, #528A41, #3D6B2E);
      background-clip: text;
      -webkit-background-clip: text;
      color: transparent;
    }

    .hero-desc {
      margin-top: 1rem;
      font-size: 1.05rem;
      color: #4E6E40;
      max-width: 68%;
      margin-left: auto;
      margin-right: auto;
    }

    /* Pilar Kajian Islam - Hijau */
    .value-pillars {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 2rem;
      margin-bottom: 3rem;
    }

    .pillar-card {
      background: #FFFFFFF0;
      backdrop-filter: blur(2px);
      border-radius: 2rem;
      padding: 1.8rem 1.2rem;
      text-align: center;
      border: 1px solid #DAEACF;
      transition: all 0.3s ease;
      box-shadow: 0 8px 18px rgba(0, 0, 0, 0.02);
    }

    .pillar-card:hover {
      transform: translateY(-5px);
      border-color: #B7D6A8;
      background: #FFFFFF;
    }

    .pillar-card i {
      font-size: 2.2rem;
      color: #619B4A;
      margin-bottom: 0.9rem;
    }

    .pillar-card h4 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.3rem;
      font-weight: 600;
      color: #3C5C30;
    }

    .pillar-card p {
      font-size: 0.85rem;
      color: #658A53;
      margin-top: 0.5rem;
    }

    /* SLIDER ARTIKEL KAJIAN & KITAB */
    .slider-section {
      margin-bottom: 2rem;
    }

    .section-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      flex-wrap: wrap;
      margin-bottom: 1.2rem;
    }

    .section-header h2 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 2rem;
      font-weight: 600;
      color: #3C5C30;
    }

    .slider-wrapper {
      position: relative;
      width: 100%;
      overflow-x: hidden;
      border-radius: 1.8rem;
      padding: 0 3.2rem;
    }

    .slider-track {
      display: flex;
      gap: 2rem;
      overflow-x: auto;
      scroll-behavior: smooth;
      scrollbar-width: thin;
      padding-bottom: 1rem;
      cursor: grab;
    }

    .slider-track::-webkit-scrollbar {
      height: 6px;
    }

    .slider-track::-webkit-scrollbar-track {
      background: #E2F0DC;
      border-radius: 12px;
    }

    .slider-track::-webkit-scrollbar-thumb {
      background: #AACD9A;
      border-radius: 12px;
    }

    .post-card-horizontal {
      flex: 0 0 350px;
      background: #FFFFFF;
      border-radius: 2rem;
      overflow: hidden;
      transition: all 0.35s cubic-bezier(0.2, 0, 0, 1);
      border: 1px solid #DAEACF;
      box-shadow: 0 16px 28px -12px rgba(45, 70, 40, 0.08);
      display: flex;
      flex-direction: column;
    }

    .post-card-horizontal:hover {
      transform: translateY(-8px);
      box-shadow: 0 28px 38px -14px rgba(55, 85, 45, 0.2);
      border-color: #C0DEB0;
    }

    .card-img {
      aspect-ratio: 16/9;
      background: #DFEED5;
      overflow: hidden;
    }

    .card-img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.45s ease;
    }

    .post-card-horizontal:hover .card-img img {
      transform: scale(1.04);
    }

    .card-body {
      padding: 1.4rem 1.4rem 1.6rem;
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    .category-chip {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: #F0F8EB;
      padding: 0.2rem 1rem;
      border-radius: 30px;
      font-size: 0.65rem;
      font-weight: 700;
      letter-spacing: 0.2px;
      color: #558B41;
      width: fit-content;
    }

    .card-title {
      font-size: 1.25rem;
      font-weight: 700;
      font-family: 'Cormorant Garamond', serif;
      line-height: 1.35;
      margin: 0.7rem 0 0.5rem;
    }

    .card-title a {
      text-decoration: none;
      color: #3C5C30;
      transition: color 0.2s;
    }

    .card-title a:hover {
      color: #6A9C5D;
    }

    .excerpt-sm {
      font-size: 0.8rem;
      line-height: 1.5;
      color: #6C8A5A;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      margin: 0.3rem 0 0.8rem;
    }

    .meta-horizontal {
      display: flex;
      justify-content: space-between;
      font-size: 0.7rem;
      font-weight: 500;
      color: #8CAC7A;
      border-top: 1px solid #E2F0DC;
      padding-top: 0.8rem;
      margin-top: auto;
    }

    .slider-controls-bottom {
      position: absolute;
      top: 50%;
      left: 0;
      right: 0;
      transform: translateY(-50%);
      display: flex;
      justify-content: space-between;
      align-items: center;
      pointer-events: none;
      z-index: 2;
    }

    .slider-btn-bottom {
      background: #FFFFFF;
      border: 1px solid #CDE2C0;
      width: 46px;
      height: 46px;
      border-radius: 50%;
      cursor: pointer;
      transition: all 0.2s;
      color: #619B4A;
      font-size: 1.1rem;
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.02);
      pointer-events: auto;
    }

    .slider-btn-bottom:hover {
      background: #F0F8EB;
      border-color: #B2D6A2;
      transform: scale(1.03);
    }

    /* KATEGORI KAJIAN & TAGS FIQIH/TAFSIR - Hijau */
    .categories-tags-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
      margin: 2.5rem 0 2rem;
    }

    .premium-card {
      background: #FFFFFF;
      border-radius: 2rem;
      padding: 1.8rem;
      border: 1px solid #DAEACF;
      transition: all 0.2s;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.02);
    }

    .premium-card h3 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.5rem;
      font-weight: 600;
      color: #3C5C30;
      margin-bottom: 1.2rem;
      display: flex;
      align-items: center;
      gap: 10px;
      border-bottom: 2px solid #E2F0DC;
      padding-bottom: 0.6rem;
    }

    .tag-group,
    .category-group {
      display: flex;
      flex-wrap: wrap;
      gap: 0.8rem;
    }

    .pill-link {
      background: #F8FEF5;
      padding: 0.5rem 1.2rem;
      border-radius: 3rem;
      font-size: 0.75rem;
      font-weight: 500;
      text-decoration: none;
      color: #5C8A48;
      transition: all 0.2s;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      border: 0.5px solid #D0E2C5;
    }

    .pill-link:hover {
      background: #EFFAE8;
      color: #3D6B2E;
      transform: translateY(-2px);
    }

    /* Daily Hadits */
    .daily-quote {
      background: #F8FEF5;
      border-radius: 2rem;
      padding: 2rem;
      margin: 2rem 0 0;
      text-align: center;
      border: 1px solid #D0E2C5;
    }

    /* Pagination Modern */
    .pagination-modern {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 0.7rem;
      margin-top: 2rem;
      flex-wrap: wrap;
    }

    .pagination-modern a,
    .pagination-modern span {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 2.5rem;
      height: 2.5rem;
      padding: 0 0.9rem;
      border-radius: 2.2rem;
      font-size: 0.85rem;
      font-weight: 500;
      text-decoration: none;
      background: #FFFFFF;
      color: #5C8A48;
      border: 1px solid #DAEACF;
    }

    .pagination-modern .active-page {
      background: #B7D6A8;
      color: #2A4522;
      border-color: #9BCC88;
    }

    /* Footer sederhana (nuansa islami hijau) */
    .footer-simple {
      margin-top: 3rem;
      background: #F8FEF5;
      border-radius: 2rem;
      padding: 1.8rem;
      text-align: center;
      border: 1px solid #DAEACF;
      color: #6C9A58;
      font-size: 0.8rem;
    }

    .footer-simple i {
      margin: 0 6px;
    }

    .jadwal-badge {
      background: #F0F8EB;
      border-radius: 1rem;
      padding: 0.5rem 1.2rem;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    @media (max-width: 880px) {
      .home-container {
        padding: 1rem;
      }

      .hero-title {
        font-size: 2.4rem;
        max-width: 100%;
      }

      .hero-desc {
        max-width: 100%;
      }

      .post-card-horizontal {
        flex: 0 0 290px;
      }

      .slider-wrapper {
        padding: 0 2.4rem;
      }

      .slider-btn-bottom {
        width: 40px;
        height: 40px;
      }

      .categories-tags-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>

<body>
  <div class="home-container">
    <!-- HERO SECTION KAJIAN ISLAM (nuansa hijau yang teduh) -->
    <div class="hero-luxury">
      <div class="hero-badge"><i class="fas fa-mosque"></i> MAJELIS ILMU · KAJIAN ISLAM & HALAQAH</div>
      <h1 class="hero-title">Menuntut ilmu adalah <span>ibadah utama</span> bagi setiap muslim</h1>
      <p class="hero-desc">Ruang kajian yang menghidupkan sunnah, menyatukan ukhuwah, dan memperdalam pemahaman agama
        dengan rujukan terpercaya.</p>
    </div>

    <!-- Pilar Kajian Islami yang lebih mendalam (warna hijau) -->
    <div class="value-pillars">
      <div class="pillar-card"><i class="fas fa-book-open"></i>
        <h4>Kitab & Tafsir</h4>
        <p>Mempelajari Al-Qur’an, Tafsir Jalalain, dan kitab kuning klasik</p>
      </div>
      <div class="pillar-card"><i class="fas fa-mosque"></i>
        <h4>Teman Hijrah Muslim</h4>
        <p>Kajian rutin untuk menambah wawasan Islam dan memperbaiki diri</p>
      </div>
      <div class="pillar-card"><i class="fas fa-hand-holding-heart"></i>
        <h4>Adab & Akhlaq</h4>
        <p>Menghidupkan akhlak mulia sesuai tuntunan Rasulullah ﷺ</p>
      </div>
    </div>

    <!-- SLIDER ARTIKEL KAJIAN (tema fiqih, tauhid, sirah) -->
    <div class="slider-section">
      <div class="section-header">
        <h2><i class="fas fa-landmark" style="color:#619B4A; margin-right: 0.6rem;"></i> Kajian & Artikel Islam Pilihan
        </h2>
      </div>
      <div class="slider-wrapper">
        <div class="slider-controls-bottom">
          <button class="slider-btn-bottom" id="slideLeftBottom" aria-label="Geser ke kiri"><i class="fas fa-chevron-left"></i></button>
          <button class="slider-btn-bottom" id="slideRightBottom" aria-label="Geser ke kanan"><i class="fas fa-chevron-right"></i></button>
        </div>
        <div class="slider-track" id="sliderTrack">
          <!-- Jika terdapat data posts dari backend maka akan dirender, namun karena ini tema Kajian Islam kita isi konten default yang memperkaya semangat ilmu dengan nuansa hijau -->
          <% if (typeof posts !=='undefined' && posts && posts.length) { posts.forEach((post)=> { %>
            <div class="post-card-horizontal">
              <div class="card-img">
                <% if (post.featuredImage) { %>
                  <img src="<%= post.featuredImage %>" alt="<%= post.title %>" loading="lazy" />
                  <% } else { %>
                    <div
                      style="background: #D9EBD0; height:100%; display: flex; align-items: center; justify-content: center; color:#6A9C5D;">
                      <i class="fas fa-quran fa-2x"></i>
                    </div>
                    <% } %>
              </div>
              <div class="card-body">
                <span class="category-chip"><i class="fas fa-tag"></i>
                  <%= post.status ? post.status.toUpperCase() : 'Kajian' %>
                </span>
                <h3 class="card-title"><a href="/posts/<%= post.slug %>" target="_blank" rel="noopener noreferrer">
                    <%= post.title %>
                  </a></h3>
                <p class="excerpt-sm">
                  <%= post.subheadline || post.excerpt || (post.content ? post.content.replace(/<[^>]*>/g, '').slice(0,
                    100) : 'Kajian mendalam seputar aqidah, fiqih kontemporer, dan adab sehari-hari') %>
                </p>
                <div class="meta-horizontal"><span><i class="far fa-clock"></i>
                    <%= post.readingTime || '5' %> menit
                  </span><span><i class="fas fa-eye"></i>
                    <%= post.viewCount || 0 %> views
                  </span></div>
              </div>
            </div>
            <% }) } else { %>
              <!-- Konten default kajian islami yang lebih mendalam (dengan nuansa hijau) -->
              <div class="post-card-horizontal">
                <div class="card-img">
                  <div
                    style="background:#E2F0DC; height:100%; display:flex; align-items:center; justify-content:center;">
                    <i class="fas fa-mosque fa-3x" style="color:#619B4A;"></i></div>
                </div>
                <div class="card-body"><span class="category-chip"><i class="fas fa-star-of-life"></i> TAUHID</span>
                  <h3 class="card-title"><a href="#">Penjelasan Kitab Tauhid Syeikh Muhammad bin Abdul Wahhab</a></h3>
                  <p class="excerpt-sm">Mengikis syirik, memperkuat keikhlasan, dan makna Laa ilaaha illallah secara
                    mendalam.</p>
                  <div class="meta-horizontal"><span>8 menit</span><span>📖 316</span></div>
                </div>
              </div>
              <div class="post-card-horizontal">
                <div class="card-img">
                  <div
                    style="background:#E2F0DC; height:100%; display:flex; align-items:center; justify-content:center;">
                    <i class="fas fa-book-atlas fa-3x" style="color:#619B4A;"></i></div>
                </div>
                <div class="card-body"><span class="category-chip">FIQIH WANITA</span>
                  <h3 class="card-title"><a href="#">Haid, Nifas, dan Panduan Thaharah Lengkap</a></h3>
                  <p class="excerpt-sm">Pembahasan berdasarkan madzhab Syafi'i, rujukan para ulama kontemporer.</p>
                  <div class="meta-horizontal"><span>6 menit</span><span>🕌 528</span></div>
                </div>
              </div>
              <div class="post-card-horizontal">
                <div class="card-img">
                  <div
                    style="background:#E2F0DC; height:100%; display:flex; align-items:center; justify-content:center;">
                    <i class="fas fa-hand-sparkles fa-3x" style="color:#619B4A;"></i></div>
                </div>
                <div class="card-body"><span class="category-chip">ADAB & DOA</span>
                  <h3 class="card-title"><a href="#">Adab Menuntut Ilmu Menurut Imam Al-Ghazali</a></h3>
                  <p class="excerpt-sm">Menghormati guru, menjaga niat, dan metode menggapai keberkahan ilmu.</p>
                  <div class="meta-horizontal"><span>5 menit</span><span>⭐ 437</span></div>
                </div>
              </div>
              <div class="post-card-horizontal">
                <div class="card-img">
                  <div
                    style="background:#E2F0DC; height:100%; display:flex; align-items:center; justify-content:center;">
                    <i class="fas fa-people-arrows fa-3x" style="color:#619B4A;"></i></div>
                </div>
                <div class="card-body"><span class="category-chip">SIRAH NABAWIYAH</span>
                  <h3 class="card-title"><a href="#">Peristiwa Isra' Mi'raj: Hikmah dan Pelajaran</a></h3>
                  <p class="excerpt-sm">Perjalanan agung Rasulullah ﷺ, perintah shalat lima waktu, bukti kekuasaan
                    Allah.</p>
                  <div class="meta-horizontal"><span>10 menit</span><span>🌟 680</span></div>
                </div>
              </div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- PAGINATION (jika backend ada) -->
    <% if (typeof pagination !=='undefined' && pagination && pagination.totalPages> 1) { %>
      <div class="pagination-modern">
        <% if (pagination.hasPrev) { %><a href="?page=<%= pagination.prevPage %>"><i class="fas fa-chevron-left"></i>
            Sebelumnya</a>
          <% } else { %><span><i class="fas fa-chevron-left"></i> Sebelumnya</span>
            <% } %>
              <% let startPage=Math.max(1, pagination.currentPage - 2); let endPage=Math.min(pagination.totalPages,
                pagination.currentPage + 2); if (endPage - startPage < 4) { if (startPage> 1) startPage = Math.max(1,
                endPage - 4); if (endPage < pagination.totalPages) endPage=Math.min(pagination.totalPages, startPage +
                  4); } for (let p=startPage; p <=endPage; p++) { %>
                  <% if (p===pagination.currentPage) { %><span class="active-page">
                      <%= p %>
                    </span>
                    <% } else { %><a href="?page=<%= p %>">
                        <%= p %>
                      </a>
                      <% } %>
                        <% } %>
                          <% if (pagination.hasNext) { %><a href="?page=<%= pagination.nextPage %>">Selanjutnya <i
                                class="fas fa-chevron-right"></i></a>
                            <% } else { %><span>Selanjutnya <i class="fas fa-chevron-right"></i></span>
                              <% } %>
      </div>
      <% } %>

        <!-- KATEGORI KAJIAN & TAGS ISLAMI (Uqud, Tafsir, dll) -->
        <div class="categories-tags-grid">
          <div class="premium-card">
            <h3><i class="fas fa-folder-open" style="color:#619B4A;"></i> Rumpun Ilmu Islam</h3>
            <div class="category-group">
              <% if (typeof categories !=='undefined' && categories && categories.length) {
                categories.forEach((category)=> { %>
                <a href="/categories/<%= category.slug %>" class="pill-link"><i class="fas fa-tag"></i>
                  <%= category.name %>
                </a>
                <% }) } else { %>
                  <a href="#" class="pill-link"><i class="fas fa-quran"></i> Tafsir Al-Qur'an</a>
                  <a href="#" class="pill-link"><i class="fas fa-book"></i> Hadits Arbain</a>
                  <a href="#" class="pill-link"><i class="fas fa-balance-scale"></i> Fiqih Muamalah</a>
                  <a href="#" class="pill-link"><i class="fas fa-heart"></i> Tasawuf & Tazkiyah</a>
                  <a href="#" class="pill-link"><i class="fas fa-history"></i> Sirah Nabawiyah</a>
                  <a href="#" class="pill-link"><i class="fas fa-language"></i> Nahwu Sharaf</a>
                  <% } %>
            </div>
          </div>
          <div class="premium-card">
            <h3><i class="fas fa-hashtag" style="color:#619B4A;"></i> Tags Populer Kajian</h3>
            <div class="tag-group">
              <% if (typeof tags !=='undefined' && tags && tags.length) { tags.forEach((tag)=> { %>
                <a href="/tags/<%= tag.slug %>" class="pill-link">#<%= tag.name %></a>
                <% }) } else { %>
                  <span class="pill-link">#TafsirIbnuKatsir</span>
                  <span class="pill-link">#BimbinganIslam</span>
                  <span class="pill-link">#HaditsShahih</span>
                  <span class="pill-link">#FiqihShalat</span>
                  <span class="pill-link">#HalaqahOnline</span>
                  <span class="pill-link">#ManhajSalaf</span>
                  <span class="pill-link">#UstadzTerpercaya</span>
                  <span class="pill-link">#DakwahDigital</span>
                  <span class="pill-link">#KajianKitabKuning</span>
                  <% } %>
            </div>
          </div>
        </div>

